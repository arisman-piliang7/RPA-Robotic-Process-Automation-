# ============================================================
# DDMS RPA - Environment Configuration
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# ============================================================

# URL DDMS PT Pertamina Patra Niaga
DDMS_URL=https://ddms.pertamina.com

# Kredensial login DDMS
DDMS_USERNAME=your_username
DDMS_PASSWORD=your_password

# Kode wilayah / area untuk filter pangkalan (opsional)
AREA_CODE=

# Mode browser: chrome atau firefox
BROWSER=chrome

# Jalankan browser tanpa tampilan (headless mode): true atau false
HEADLESS=false

# Batas waktu tunggu elemen (detik)
IMPLICIT_WAIT=10
EXPLICIT_WAIT=30
PAGE_LOAD_TIMEOUT=60

# Direktori output untuk hasil laporan
OUTPUT_DIR=output

# Direktori log
LOG_DIR=logs
LOG_LEVEL=INFO
